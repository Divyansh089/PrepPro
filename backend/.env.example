PORT=5000
CORS_ORIGIN=http://localhost:3000

# Matches docker-compose.yml
DATABASE_URL=postgresql://preppro:preppro@localhost:5433/preppro
REDIS_URL=redis://localhost:6379

# Use a long random string
JWT_SECRET=change-me

# Optional: without these, the app uses fallback questions / scores
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Code runner. The free public Judge0 needs no key.
# For RapidAPI use JUDGE0_URL=https://judge0-ce.p.rapidapi.com and set JUDGE0_API_KEY.
JUDGE0_URL=https://ce.judge0.com
JUDGE0_API_KEY=
