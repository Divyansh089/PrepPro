generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Category {
  QUANT
  VERBAL
  APTITUDE
  REASONING
  CODING
  DBMS
  OS
  NETWORKS
  CLOUD
  SYSTEM_DESIGN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionType {
  SINGLE_CHOICE
  MULTI_CHOICE
  SHORT_TEXT
}

enum QuestionSource {
  BANK // seeded from prisma/questions.json
  AI // generated by Gemini
}

enum TestMode {
  PRACTICE
  ASSESSMENT
}

enum TestStatus {
  IN_PROGRESS
  COMPLETED
}

enum Level {
  FRESHER
  MID
  SENIOR
}

enum InterviewType {
  TECHNICAL
  BEHAVIORAL
  SYSTEM_DESIGN
  MIXED
}

enum InterviewStatus {
  IN_PROGRESS
  COMPLETED
}

enum Sender {
  AI
  USER
}

// ---------- Models ----------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  college      String?
  gradYear     Int?
  targetRole   String?
  bio          String?
  avatarUrl    String?
  totalPoints  Int      @default(0) // used by the leaderboard
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tests      Test[]
  interviews Interview[]
}

model Question {
  id            String         @id @default(cuid())
  category      Category
  difficulty    Difficulty
  type          QuestionType
  text          String
  options       String[] // empty for SHORT_TEXT
  correctAnswer String[] // one item for SINGLE_CHOICE / SHORT_TEXT
  explanation   String
  source        QuestionSource @default(BANK)
  createdAt     DateTime       @default(now())

  testQuestions TestQuestion[]

  @@index([category, difficulty])
}

// One PRACTICE or ASSESSMENT attempt by a user
model Test {
  id             String     @id @default(cuid())
  userId         String
  mode           TestMode
  category       Category
  difficulty     Difficulty
  status         TestStatus @default(IN_PROGRESS)
  totalQuestions Int
  correctCount   Int        @default(0)
  score          Int        @default(0) // 0-100
  feedback       Json? // AI feedback after submit
  startedAt      DateTime   @default(now())
  completedAt    DateTime?

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions TestQuestion[]

  @@index([userId])
}

// A question inside a test + what the user answered
model TestQuestion {
  id         String   @id @default(cuid())
  testId     String
  questionId String
  order      Int
  userAnswer String[]
  isCorrect  Boolean? // null until the test is submitted

  test     Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])

  @@unique([testId, questionId])
}

model Interview {
  id                  String          @id @default(cuid())
  userId              String
  role                String
  level               Level
  type                InterviewType
  language            String
  company             String?
  status              InterviewStatus @default(IN_PROGRESS)
  overallScore        Int? // scores are 0-100, set when the interview ends
  technicalScore      Int?
  communicationScore  Int?
  problemSolvingScore Int?
  feedback            String?
  startedAt           DateTime        @default(now())
  completedAt         DateTime?

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages InterviewMessage[]

  @@index([userId])
}

model InterviewMessage {
  id          String   @id @default(cuid())
  interviewId String
  sender      Sender
  content     String
  code        String?
  language    String?
  createdAt   DateTime @default(now())

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId])
}
